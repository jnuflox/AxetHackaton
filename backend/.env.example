# Server Configuration
PORT=3000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/sistema-gestion-proyectos

# JWT
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:4200

# External APIs
SONARQUBE_URL=http://localhost:9000
SONARQUBE_TOKEN=your-sonarqube-token
SONAR_SERVER_URL=http://localhost:9000
SONAR_TOKEN=your-sonarqube-token-here

JIRA_URL=https://your-instance.atlassian.net
JIRA_USERNAME=your-email@example.com
JIRA_API_TOKEN=your-jira-api-token

GITLAB_URL=https://gitlab.com
GITLAB_TOKEN=your-gitlab-token

# SQLite Configuration for SonarQube metrics
SQLITE_DB_PATH=./sonar_metrics.db
